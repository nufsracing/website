<footer class="foot wrap">
  <div class="foot-grid">
    <div class="foot-brand">
      <a class="mark" href="/"><img src="/assets/img/nufs-wordmark.png" alt="NUFS" width="946" height="152"></a>
      <p class="foot-blurb">Northumbria University Formula Student. Newcastle upon Tyne, United Kingdom.</p>
    </div>

    <div>
      <h4 class="label">Pages</h4>
      <ul>
        {% for item in site.nav %}
          {% if item.live and item.url != "/" %}
            <li><a href="{{ item.url }}">{{ item.label }}</a></li>
          {% endif %}
        {% endfor %}
        <li><a href="{{ site.sponsorUrl }}">Sponsor Us</a></li>
      </ul>
    </div>

    <div>
      <h4 class="label">Contact</h4>
      <ul>
        {% if site.emails.sponsorship %}<li><a href="mailto:{{ site.emails.sponsorship }}">{{ site.emails.sponsorship }}</a></li>{% endif %}
        {% if site.emails.general %}<li><a href="mailto:{{ site.emails.general }}">{{ site.emails.general }}</a></li>{% endif %}
        {% if site.emails.media %}<li><a href="mailto:{{ site.emails.media }}">{{ site.emails.media }}</a></li>{% endif %}
      </ul>
    </div>

    <div>
      <h4 class="label">Follow</h4>
      <ul>
        {% if site.social.instagram %}<li><a href="{{ site.social.instagram }}">Instagram</a></li>{% endif %}
        {% if site.social.linkedin %}<li><a href="{{ site.social.linkedin }}">LinkedIn</a></li>{% endif %}
      </ul>
    </div>
  </div>

  <div class="foot-base">
    <span>&copy; 2026 NUFS Racing</span>
    <span>Season 2026 / 2027</span>
    {% if site.analyticsId %}
      <span>
        We use Google Analytics to count visits.
        <button type="button" class="link-btn" id="analyticsToggle" data-ga="{{ site.analyticsId }}">Turn off</button>
      </span>
    {% endif %}
    {% if site.credits %}<span>{{ site.credits }}</span>{% endif %}
  </div>
</footer>