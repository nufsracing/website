<svg
  class="racing-line"
  viewBox="0 0 1440 900"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <path
      id="rl"
      pathLength="1"
      vector-effect="non-scaling-stroke"
      d="{{ racingLine or 'M 1000,-40 C 1040,150 1330,200 1350,330 C 1370,460 1000,470 900,600 C 810,720 1060,820 1140,960' }}"
    ></path>
  </defs>
  <!-- the homepage racing line, unless the page sets it's own racing line -->
  <use href="#rl" class="rl-band"></use>
  <!-- faint full route underneath, the bright line draws as far as you have scrolled -->
  <use href="#rl" class="rl-core rl-core-faint"></use>
  <use href="#rl" class="rl-core" id="rlCore"></use>
  <g class="rl-dot" id="rlDot">
    <circle class="rl-dot-ring" r="10"></circle>
    <circle class="rl-dot-core" r="4"></circle>
  </g>
</svg>
