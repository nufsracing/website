<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | {{ site.shortName }}</title>
    <meta name="description" content="{{ site.description }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap">
    <link rel="stylesheet" href="/assets/css/site.css">
</head>
<script src="/assets/js/site.js" defer>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
        document.documentElement.classList.add("js-reveal")
    }
</script>
<body>
    {% include "partials/racing-line.njk" %}
    {% include "partials/nav.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
</body>
</html>
