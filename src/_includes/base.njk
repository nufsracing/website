<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} | {{ site.shortName }}</title>
    <meta name="description" content="{{ site.description }}">
    <!-- what messaging apps show when the link is shared -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.shortName }}">
    <meta property="og:title" content="{{ site.name }}">
    <meta property="og:description" content="{{ site.description }}">
    <meta property="og:url" content="{{ baseUrl }}{{ page.url }}">
    <meta property="og:image" content="{{ baseUrl }}/assets/img/og.jpg">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Archivo+Black&display=swap">
    <!-- tab icon, the N from the NUFS logo -->
    <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
    <link rel="stylesheet" href="/assets/css/site.css">
    <script>
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) {
            document.documentElement.classList.add("js-reveal")
            }
    </script>
{% if site.analyticsId %}
<script>
  // skip analytics if this visitor turned it off in the footer
  let analyticsOff = false;
  try { analyticsOff = localStorage.getItem("analytics-off") === "1"; } catch (e) {}
  // only count visits on the real site, not local dev or preview links
  if (location.hostname === "nufsracing.co.uk" && !analyticsOff) {
    const ga = document.createElement("script");
    ga.async = true;
    ga.src = "https://www.googletagmanager.com/gtag/js?id={{ site.analyticsId }}";
    document.head.appendChild(ga);
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { dataLayer.push(arguments); };
    gtag("js", new Date());
    gtag("config", "{{ site.analyticsId }}");
  }
</script>
{% endif %}
</head>
<body>
    {% include "partials/racing-line.njk" %}
    {% include "partials/nav.njk" %}

    <main>
        {{ content | safe }}
    </main>

    {% include "partials/footer.njk" %}
    <script src="/assets/js/site.js" defer></script>
</body>
</html>
