<!-- Hero section of the home page-->
<section class="hero">
  <div class="hero-col">
    <p>Season 2026/2027 · Northumbria University</p>
    <h1>This year marks our debut season into Formula Student.</h1>
    <p class="lede">
      Northumbria University's first entry. Designed, manufactured, wired and
      run by students at every level, from suspension geometry to the business
      case, over twelve months and one shot at Silverstone.
    </p>
    <button href="/sponsor/">Sponsor Us</button>
    <button>See the build plan</button>
  </div>

  <div class="hero-col">
    <div class="clock" data-target="{{ site.competition.date }}"></div>
    <p>FS UK · Silverstone</p>
  </div>
</section>

<!-- The teams figures such as members, subteams, etc -->

<section class="figures wrap">
  <ul>
    <li class="fig">
      <span class="fig-value">60</span>
      <span class="fig-label">Members</span>
      <span class="fig-note">Across engineering, business and design.</span>
    </li>
    <li class="fig">
      <span class="fig-value">8</span>
      <span class="fig-label">Sub Teams</span>
      <span class="fig-note"
        >Every part of the car and the campaign behind it.</span
      >
    </li>
    <li class="fig">
      <span class="fig-value">1st</span>
      <span class="fig-label">Season</span>
      <span class="fig-note">Building from nothing in twelve months.</span>
    </li>
    <li class="fig">
      <span class="fig-value fig-value--accent">2027</span>
      <span class="fig-label">Silverstone</span>
      <span class="fig-note">FS UK in July. Our first time on the grid</span>
    </li>
  </ul>
</section>

<!-- Team photo goes here once the full team photo is taken -->

<!-- Silverstone track -->
<section class="band wrap" id="venue">
  <div class="venue-grid">
    <div class="venue-copy">
      <p class="label">The Venue</p>
      <h2>Silverstone, Northamptonshire</h2>
      <p class="lede">Four days in July. Scrutineering first, because nothing else happens until the car passes it, then the static events and finally the rund that decide the weekend.</p>
      <dl>
        <div><dt class="layout">name</dt><dd>{{ site.competition.name }}</dd></div>
        <div><dt class="label">Event</dt><dd>{{ site.competition.date }}</dd></div>
      </dl>
    </div>
    <div class="venue-art">
    {% include "partials/circuit.svg" %}
    </div>

  </div>
</section>

<!-- what is formula student -->
<section class="briefing">
  <div class="briefing-col">
    <p>THE COMPETITION</p>
    <h1>What is Formula Student?</h1>
    <p class="intro-brief">
      Formula Student, known as Formula SAE outside Europe, is an international
      engineering competition in which university teams design, build, test and
      race a single seater car from scratch.
    </p>
    <p class="cont-brief">
      It is not only a race. Teams are judged on the engineering behind the car,
      on the cost and manufacturing plan, and on a business case put to a panel
      of industry judges, so the competition rewards sound engineering and
      project management as much as outright speed.
    </p>
    <p class="final-brief">
      Universities from across the UK, Europe and the rest of the world compete
      against cars built the same way: by students, on student budgets, in
      roughly a year.
    </p>
  </div>
</section>

<section class="stats-dyns-events">
  <div class="event-group">
    <span class="tag">STATIC EVENTS</span>
    <ul>
      <li class="stat">
        <span class="stat-label"><b>Business Plan</b></span>
        <span class="stat-note">the case for the car as a product.</span>
      </li>
      <li class="stat">
        <span class="stat-label"><b>Cost and Manufacturing</b></span>
        <span class="stat-note">every part, costed and justified.</span>
      </li>
      <li class="stat">
        <span class="stat-label"><b>Engineering Design</b></span>
        <span class="stat-note">defending the design to judges.</span>
      </li>
    </ul>
  </div>
  <div class="event-group">
    <span class="tag">DYNAMIC EVENTS</span>
    <ul>
      <li class="dyn">
        <span class="dyn-label"><b>Acceleration</b></span>
        <span class="dyn-note">75 m standing start.</span>
      </li>
      <li class="dyn">
        <span class="dyn-label"><b>Skid Pad</b></span>
        <span class="dyn-note">figure of eight.</span>
      </li>
      <li class="dyn">
        <span class="dyn-label"><b>Sprint</b></span>
        <span class="dyn-note">one flying lap.</span>
      </li>
      <li class="dyn">
        <span class="dyn-label"><b>Endurance</b></span>
        <span class="dyn-note">22 km</span>
      </li>
      <li class="dyn">
        <span class="dyn-label"><b>Efficiency</b></span>
        <span class="dyn-note">energy over the endurance run.</span>
      </li>
    </ul>
  </div>
</section>

<!-- plan cards -->
<section class="band wrap rule-top" id="plan">
  <div class="head">
    <p class="label">The Season</p>
    <h3>Our Plan</h3>
    <p>Four phases, twelve months, one deadline that does not move.</p>
  </div>
  <div class="phases">
    {% for phase in phases %}
      <article class="phase {% if phase.status %} {{ phase.status }} {% endif %}">
        <span class="when">{{ phase.duration }}</span>
        {% if phase.status == "now" %}
          <span class="label flag">Where we are now</span>
        {% endif %}
        <span>{{ phase.name }}</span>
        <span>{{ phase.summary }}</span>
      </article>
    {% endfor %}
  </div>
</section>

