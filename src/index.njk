---
layout: base.njk
title: Home
---

<!-- Hero section of the home page-->
<section class="hero wrap">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="label">Season 2026/2027 · Northumbria University</p>
      <h1>Northumbria's first <span class="soft">Formula Student</span> car.</h1>
      <p class="lede">
        A new Northumbria team, designed, manufactured, wired and
        run by students at every level, from suspension geometry to the business
        case, over twelve months and one shot at Silverstone.
      </p>
      <div class="actions">
        <a class="btn" href="#closing">Sponsor Us <span aria-hidden="true">&rarr;</span></a>
        <a class="btn btn-ghost" href="#plan">See the build plan</a>
      </div>
    </div>

    <aside class="season" id="season" aria-label="Season progress" data-phases="{% for phase in phases %}{{ phase.start }} {% endfor %}{{ site.competition.seasonEnd }}">
      <div class="race-top">
        <span class="race-title">Race Day</span>
        <span class="label race-live"><span class="race-dot"></span>Counting down</span>
      </div>
      <div class="race-units" aria-hidden="true">
        <div><span class="race-n" data-unit="days">0</span><span class="lebel">Days</span></div>
        <div><span class="race-n" data-unit="hours">00</span><span class="label">Hours</span></div>
        <div><span class="race-n" data-unit="mins">00</span><span class="label">Mins</span></div>
        <div><span class="race-n" data-unit="secs">00</span><span class="label">Sec</span></div>
      </div>
      <p class="visually-hidden" id="raceSummary"></p>
      <div class="race-foot label">
        <span>FS UK · Silverstone</span>
        <span>{% if site.competition.raceDayConfirmed %}{{ site.raceDayLabel }}{% else %}July 2027 · date TBC</span>
      </div>
    </aside>
  </div>
</section>

<!-- The teams figures such as members, subteams, etc -->

<section class="wrap" id="figures">
  <ul class="figures">
    <li class="fig">
      <span class="n"><span data-count="{{ site.members }}">{{ site.members }}</span><span class="plus">+</span></span>
      <span class="label">Members</span>
      <span class="s">Across engineering, business and design.</span>
    </li>
    <li class="fig">
      <span class="n" data-count="{{ subteam | length }}">{{ subteam | length }}</span>
      <span class="label">Sub teams</span>
      <span class="s"
        >Every part of the car and the campaign behind it.</span
      >
    </li>
    <li class="fig">
      <span class="n">1st</span>
      <span class="label">Season</span>
      <span class="s">Building from nothing in twelve months.</span>
    </li>
    <li class="fig">
      <span class="n">2027</span>
      <span class="label">Silverstone</span>
      <span class="s">FS UK in July. Our first time on the grid.</span>
    </li>
  </ul>
</section>

<!-- societies fair photo. swap for the team photo once it's taken -->
<section class="wrap photo-band" id="fair">
  <div class="photo-grid single">
    <figure class="ph">
      <img src="/assets/img/fair-queue.webp" width="1720" height="736" loading="lazy" alt="A queue of students at the NUFS stall during the societies fair, with the Get Involved screen and the sim rig" />
      <figcaption class="ph-title">
        <span class="label">Societies fair · September 2026</span>
        <span class="ph-h">Day one.</span>
      </figcaption>
    </figure>
  </div>
</section>

<!-- Silverstone track -->
<section class="band wrap" id="venue">
  <div class="venue-grid">
    <div class="venue-copy">
      <p class="label">The Venue</p>
      <h2>Silverstone, Northamptonshire</h2>
      <p class="lede">Four days in July. Scrutineering first, because nothing else happens until the car passes it, then the static events and finally the runs that decide the weekend.</p>
      <dl class="spec">
        <div><dt class="label">name</dt><dd>{{ site.competition.name }}</dd></div>
        <div><dt class="label">Event</dt><dd>{{ site.competition.date }}</dd></div>
      </dl>
    </div>
    <div class="venue-art">
    {% include "partials/circuit.svg" %}
    </div>

  </div>
</section>

<!-- what is formula student -->
<section class="band wrap rule-top" id="about">
  <div class="about-grid">
    <div class="about-body">
      <div class="head">
        <p class="label">The competition</p>
        <h2>What is Formula&nbsp;Student?</h2>
      </div>
      <p class="first">Formula Student, known as Formula SAE outside Europe, is an international engineering competition in which university teams design, build, test and race a single seater car from scratch.</p>
      <p>Only <b class="pts-inline">{{ events | points("dynamic") }}</b> of the 1,000 points are won on track. The rest are decided in a room, defending the design, the cost report and the business case to a panel of industry judges. A fast car with a weak case loses to a slower one with a strong one.</p>
    </div>

    <!-- points per event come from events.json, FSUK 2026 rules table 1 -->
    <div class="scoring">
      <div class="score-head">
        <span class="label">How the 1,000 points are won</span>
        <div class="score-split">
          <span class="score-fig"><b class="n static" data-count="{{ events | points("static") }}">{{ events | points("static") }}</b><span class="s">in the judging rooms</span></span>
          <span class="score-fig"><b class="n dynamic" data-count="{{ events | points("dynamic") }}">{{ events | points("dynamic") }}</b><span class="s">on the track</span></span>
        </div>
      </div>

      <!-- one strip, each segment as wide as its points -->
      <div class="score-bar" aria-hidden="true">
        {% for event in events %}
          <span class="score-seg {{ event.type }}" style="--pts: {{ event.points }}"></span>
        {% endfor %}
      </div>

      <div class="events">
        <div class="ev-group">
          <span class="label">Static events</span>
          {% for event in events %}{% if event.type == "static" %}
            <div class="ev-row"><b>{{ event.name }}</b><span class="m">{{ event.summary }}</span><span class="pts">{{ event.points }}</span></div>
          {% endif %}{% endfor %}
        </div>
        <div class="ev-group">
          <span class="label">Dynamic events</span>
          {% for event in events %}{% if event.type == "dynamic" %}
            <div class="ev-row"><b>{{ event.name }}</b><span class="m">{{ event.summary }}</span><span class="pts dynamic">{{ event.points }}</span></div>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Build Plan. the wrapper gives the section room to pin while you scroll through the phases -->
<div class="pin-wrap" id="planPin">
<section class="band wrap rule-top" id="plan">
  <div class="head">
    <div class="season-count">
      <span class="num">10</span>
      <span class="what">months to go</span>
    </div>
    <p class="label">The season</p>
    <h2>Our plan</h2>
    <p class="lede">Four phases, twelve months, one deadline that does not move.</p>
    <div class="track plan-track" aria-hidden="true">
      {% for phase in phases %}<span class="seg"></span>{% endfor %}
    </div>
  </div>
  <div class="phases">
    {% for phase in phases %}
      <article class="phase {% if phase.status %} {{ phase.status }} {% endif %}">
        <span class="when">{{ phase.duration }}</span>
        {% if phase.status == "now" %}
          <span class="label flag">Where we are now</span>
        {% endif %}
        <h3>{{ phase.name }}</h3>
        <p>{{ phase.summary }}</p>
      </article>
    {% endfor %}
  </div>
</section>
</div>

<!-- short sponsor pitch for the home page. -->
<section class="partner-band" id="partners">
  <div class="wrap partner-band-inner">
    <div class="partner-head">
      <div class="head">
        <p class="label">Partner with us</p>
        <h2>Four ways to back the team.</h2>
        <p class="lede">From a logo on the website to a founding role in how the team is shaped. Every tier puts your name on the car at Silverstone.</p>
      </div>
      <!-- the tiers button comes back once the sponsor page exists:
           <a class="btn btn-dark" href="{{ site.sponsorUrl }}">See partner tiers <span aria-hidden="true">&rarr;</span></a> -->
    </div>

    <ul class="tier-list">
      {% for tier in tiers %}
        <li class="tier{% if tier.featured %} featured{% endif %}">
          <span class="label">{{ tier.name }}</span>
          <span class="tier-price">{{ tier.price }}</span>
          <span class="tier-summary">{{ tier.summary }}</span>
        </li>
      {% endfor %}
    </ul>

    <!-- partner logos go here once the banner is signed off -->
    {% include "partials/logos.njk" %}
  </div>
</section>

<!-- join and sponsor cards -->
{% include "partials/closing.njk" %}

