---
layout: base.njk
title: Team
permalink: /team/
description: "Meet the students leading Northumbria's first Formula Student team, from the committee to the sub team leads."
pageCss: team.css
pageJs: team.js
# a chicane down the right of the hero, the home page uses a sweeping bend and sponsor a long straight
racingLine: "M 1300,-40 L 1300,240 C 1300,330 1120,350 1120,450 C 1120,560 1330,580 1330,700 L 1330,960"
---

{# the people on this page live in src/_data/team.json, edit names, roles and bios there #}
{% set plus %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14"/></svg>{% endset %}

<!-- page head -->
<section class="hero wrap tm-head">
  <div class="hero-copy">
    <h1>The people building <span class="soft">car one.</span></h1>
    <p class="lede">{{ site.members }}+ students across {{ subteam | length }} sub teams. These are the people leading them.<br>Pick anyone to read why they joined.</p>
  </div>
</section>

<!-- leads, committee and sub team leads. the photo is added by team.js and the initials show if it is missing -->
{% for group in team %}
<section class="band wrap rule-top" id="{{ group.id }}">
  <div class="head">
    <p class="label">{{ group.label }}</p>
    <h2>{{ group.heading }}</h2>
  </div>

  <div class="tm-grid">
    {% for person in group.people %}
    <article class="member"{% if person.linkedin %} data-linkedin="{{ person.linkedin }}"{% endif %}{% if person.photo %} data-photo="/assets/img/{{ person.photo }}"{% endif %}>
      <div class="member-card">
        <span class="member-face" aria-hidden="true">{{ person.initials }}</span>
        <button class="member-open" type="button" aria-haspopup="dialog" aria-label="Read about {{ person.short or person.name.split(' ')[0] }}">
          {{ plus | safe }}
        </button>
      </div>
      <div class="member-tag">
        <h3 class="member-name">{{ person.name }}</h3>
        <p class="member-role">{{ person.role }}</p>
      </div>
      <div class="member-bio" hidden>
        <p class="label">{{ person.bioLabel or "Why I joined" }}</p>
        <p>{{ person.bio }}</p>
      </div>
    </article>
    {% endfor %}
  </div>
</section>
{% endfor %}

<!-- the popup that opens when a person is clicked, filled in by team.js -->
<dialog class="member-dialog" id="memberDialog" aria-labelledby="mdName">
  <div class="md-bg" aria-hidden="true"></div>
  <div class="md-face" id="mdFace" aria-hidden="true"></div>
  <div class="md-info" tabindex="-1" autofocus>
    <p class="label md-role" id="mdRole"></p>
    <h2 class="md-name" id="mdName"></h2>
    <div class="md-body" id="mdBody"></div>
    <a class="md-link" id="mdLink" href="#" target="_blank" rel="noopener" hidden>LinkedIn <span aria-hidden="true">&rarr;</span></a>
  </div>
  <button class="md-close" type="button" id="mdClose" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
</dialog>

<!-- one button through to the sponsor page -->
<section class="band wrap rule-top" id="support">
  <div class="tm-cta">
    <div class="head">
      <p class="label">Support the team</p>
      <h2>Back the students building car one.</h2>
      <p class="lede">Every part of the car is designed and built by the people on this page. Partners help them get it to {{ site.competition.venue }}.</p>
    </div>
    <a class="btn" href="{{ site.sponsorUrl }}" data-track="team_support">Support the students <span aria-hidden="true">&rarr;</span></a>
  </div>
</section>
