---
layout: base.njk
title: Sponsor Us
permalink: /sponsor/
description: "Back Northumbria's first Formula Student team on its way to Silverstone. Five partner tiers, or support the build in kind with materials, machining or software."
pageCss: sponsor.css
pageJs: sponsor.js
racingLine: "M 1110,-40 L 1110,430 C 1110,620 1050,700 920,760 C 800,815 740,880 730,960"
---

<!-- page head  -->
<section class="hero wrap sp-head">
  <p class="gantry-ask">How quick are you?</p>
  <div class="gantry-wrap">
    <button class="gantry" id="gantry" type="button" aria-describedby="gantryMsg">
      <span class="gantry-lights" aria-hidden="true">
        {%- for n in range(0, 5) %}<span class="pod"><i></i><i></i></span>{% endfor -%}
      </span>
      <span class="visually-hidden">Reaction test</span>
    </button>
    <div class="gantry-foot">
      <p class="label gantry-msg" id="gantryMsg" aria-live="polite">Tap the lights to start</p>
      <p class="label gantry-days" id="spLive" data-start="{{ site.competition.raceDay }}" hidden>
        <span id="spDays"></span> days to lights out at {{ site.competition.venue }}{% if not site.competition.raceDayConfirmed %} &middot; date TBC{% endif %}
      </p>
      <p class="label gantry-best" id="gantryBest"></p>
    </div>
  </div>

  <div class="hero-copy sp-copy">
    <h1>Why back a <span class="soft">first season.</span></h1>
    <p class="lede">{{ site.members }} Northumbria students are building the university's first Formula Student car from scratch and taking it to {{ site.competition.venue }}. Partners who join now are with us from the first cut of metal.</p>
    <div class="actions">
      <a class="btn" href="#enquire" data-track="sponsor_enquire">Get in touch <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>


<!-- why a first season, between the head and the tiers -->
<section class="band wrap rule-top" id="why">
  <div class="why-grid">
    <div class="head why-head">
      <p class="label">Why now</p>
      <h2>What an established team can't offer you.</h2>
      {% if site.instagramMonthlyViews %}<p class="why-reach">Our Instagram gets <b class="why-fig">{{ site.instagramMonthlyViews }}</b> views a month.</p>{% endif %}
    </div>
    <ol class="why-list">
      <li class="why-item">
        <span class="why-n">01</span>
        <div>
          <h3>Your name on car one</h3>
          <p>The partners who back the first NUFS car are part of how the team started, not a logo added later.</p>
        </div>
      </li>
      <li class="why-item">
        <span class="why-n">02</span>
        <div>
          <h3>Room on the car</h3>
          <p>Established teams carry dozens of logos. A first car carries a few, so yours isn't lost in the crowd.</p>
        </div>
      </li>
      <li class="why-item">
        <span class="why-n">03</span>
        <div>
          <!-- reword this one in January, the design phase ends in December -->
          <h3>Your input still counts</h3>
          <p>We're in concept and design until December. Advice from your engineers now can still change how the car is built.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<section class="band wrap rule-top" id="tiers">

  <!-- pattnership banner goes here when we get sponsors -->

  <!-- sponsor tier card section -->
  <div class="head">
    <p class="label">Partner tiers</p>
    <h2>Five ways to back the team.</h2>
    <p class="lede">Each tier includes everything in the one before it. Prices are a starting point, so if something doesn't fit, ask and we'll work it out.</p>
  </div>

  <!-- Supporting Partner runs as a strip above the cards -->
  {% for tier in tiers %}
    {% if tier.strip %}{% include "partials/tier-strip.njk" %}{% endif %}
  {% endfor %}

  <div class="tier-grid">
    {% for tier in tiers %}
      {% if not tier.flagship and not tier.strip %}
        {% include "partials/tier-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>

  <!-- Founding partner gets the red card-->
  {% for tier in tiers %}
    {% if tier.flagship %}
      <article class="flagship" id="tier-{{ tier.id }}">
        <div class="flag-left">
          <div class="lights lights-max" aria-hidden="true">
            {%- for n in range(0, 10) %}<i class="{{ 'on' if n < tier.lights }}" style="--n:{{ n }}"></i>{% endfor -%}
          </div>
          <span class="label">Tier {{ tier.tier }} &middot; Flagship &middot; Price {{ tier.price }}</span>
          <div class="flag-name">
            <h3>{{ tier.name }}</h3>
            {% if tier.tag %}<span class="flag-tag">{{ tier.tag }}</span>{% endif %}
          </div>
          <p>{{ tier.summary }} {{ tier.foot }}</p>
        </div>
        <div class="flag-right">
          <p class="inherits">Includes {{ tier.inherits }}</p>
          <ul class="benefits">
            {% for benefit in tier.benefits %}
              <li>{{ benefit }}</li>
            {% endfor %}
          </ul>
          <a class="btn btn-light" href="#enquire" data-tier="{{ tier.name }}">Start the conversation <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    {% endif %}
  {% endfor %}
</section>

<!-- big statement with picture -->
<section class="statement-band" id="statementBand" aria-label="Founding Partner" data-clip="/assets/img/sim-wheel-scrub.mp4" data-poster="/assets/img/sim-wheel-scrub-poster.jpg">
  <img class="statement-photo" src="/assets/img/sim-wheel.webp" width="1920" height="1280" loading="lazy" alt="">
  <div class="statement wrap">
    <p class="scrub" id="scrub">After we compete at {{ site.competition.venue }}, we will <em>never</em> be a new team again. Founding Partner happens <em>once.</em></p>
    <p class="label statement-cap">Sim rig &middot; September 2026</p>
  </div>
</section>

<!-- cash and kit section -->
<section class="split" id="inkind">
  <div class="split-half split-cash">
    <div class="split-inner">
      <p class="label">Two ways to help</p>
      <h2 class="split-word">Financial.</h2>
      <p>Pick a partner tier. Each one includes everything in the tier before it.</p>
      <ul class="route-tiers">
        {% for tier in tiers %}
          <li>
            <a href="#tier-{{ tier.id }}">
              <span>{{ tier.name }}</span>
              <span class="mini-lights" aria-hidden="true">
                {%- for n in range(0, 10) %}<i class="{{ 'on' if n < tier.lights }}"></i>{% endfor -%}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="split-half split-kit">
    <div class="split-inner">
      <p class="label">Both count the same</p>
      <h2 class="split-word">In kind.</h2>
      <p>Materials, machining time, software, testing space, transport or expertise. We price your package on the value of what you give us, and we'll align your support with the correct partner package. We'll also write up how your work ended up on the car.</p>
      <fieldset class="kit" id="kitPicker">
        <legend class="label">What could you offer?</legend>
        <label class="kit-chip"><input type="checkbox" value="Steel and aluminium" data-team="Chassis &amp; Suspension"><span>Steel and aluminium</span></label>
        <label class="kit-chip"><input type="checkbox" value="Carbon fibre and composites" data-team="Aerodynamics"><span>Carbon and composites</span></label>
        <label class="kit-chip"><input type="checkbox" value="Machining time" data-team="Manufacturing &amp; Fabrication"><span>Machining time</span></label>
        <label class="kit-chip"><input type="checkbox" value="Engine and fuel system parts" data-team="Powertrain &amp; Engine"><span>Engine parts</span></label>
        <label class="kit-chip"><input type="checkbox" value="Brake components" data-team="Brakes &amp; Dynamics"><span>Brakes</span></label>
        <label class="kit-chip"><input type="checkbox" value="Wiring, sensors and electronics" data-team="Electrical"><span>Electronics</span></label>
        <label class="kit-chip"><input type="checkbox" value="CAD and simulation software" data-team="every engineering team"><span>Software</span></label>
        <label class="kit-chip"><input type="checkbox" value="Transport" data-team="getting the car to Silverstone"><span>Transport</span></label>
      </fieldset>
      <ul class="kit-uses" id="kitUses" aria-live="polite"></ul>
      <a class="btn btn-dark" href="#enquire" data-tier="In kind support">Offer support <span aria-hidden="true">&rarr;</span></a>
      <p class="sp-email">{{ site.emails.sponsorship }}</p>
    </div>
  </div>
</section>

<!-- Writes small email for potential sponsors -->
<section class="band wrap" id="enquire">
  <div class="head">
    <p class="label">Get in touch</p>
    <h2>Let's build this together.</h2>
    <p class="lede">Tell us which tier you're interested in, or ask about something that doesn't fit one. The email writes itself as you fill this in, so send it from your own inbox or copy it.</p>
  </div>

  <div class="enquiry">
    <form class="enq-form" id="enqForm" data-email="{{ site.emails.sponsorship }}" data-season="{{ site.season }}">
      <fieldset class="enq-tiers">
        <legend class="label">Interested in</legend>
        {% for tier in tiers %}
          <label class="chip"><input type="radio" name="tier" value="{{ tier.name }}"><span>{{ tier.id | capitalize }}</span></label>
        {% endfor %}
        <label class="chip"><input type="radio" name="tier" value="In kind support"><span>In kind</span></label>
        <label class="chip"><input type="radio" name="tier" value="" checked><span>Not sure yet</span></label>
      </fieldset>
      <label class="field" for="enqOrg"><span class="label">Organisation <em>optional</em></span><input id="enqOrg" type="text" autocomplete="organization" placeholder="Tyne Precision Ltd"></label>
      <label class="field" for="enqName"><span class="label">Your name</span><input id="enqName" type="text" autocomplete="name" placeholder="Sam Taylor"></label>
      <label class="field" for="enqNote"><span class="label">Anything to add <em>optional</em></span><textarea id="enqNote" rows="3" placeholder="We machine aluminium parts and have spare capacity in spring."></textarea></label>
    </form>

    <article class="enq-mail">
      <div class="enq-meta">
        <span class="label">To</span><span class="enq-to">{{ site.emails.sponsorship }}</span>
        <span class="label">Subject</span><span id="enqSubject">NUFS partnership enquiry</span>
      </div>
      <pre class="enq-body" id="enqBody"></pre>
      <div class="actions">
        <a class="btn btn-light" id="enqSend" href="mailto:{{ site.emails.sponsorship }}" data-track="sponsor_email">Open in email <span aria-hidden="true">&rarr;</span></a>
        <button class="btn btn-ghost" type="button" id="enqCopy">Copy email</button>
      </div>
    </article>
  </div>
</section>
